# ─── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → your project → Connect → choose the *Pooled* connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Admin login ─────────────────────────────────────────────────
# The email you'll use to sign in at /admin/login
ADMIN_EMAIL="you@example.com"
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH="scrypt:<salt>:<hash>"
# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# ─── Site ────────────────────────────────────────────────────────
# Your public URL (no trailing slash). Used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

